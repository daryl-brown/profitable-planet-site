# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored — never commit real values.
# Set matching variables in the Vercel dashboard for production.

# Spotify for Podcasters RSS feed URL
# Pattern: https://anchor.fm/s/[SHOW_ID]/podcast/rss
RSS_FEED_URL=https://anchor.fm/s/[SHOW_ID]/podcast/rss

# Story Session booking URL (on darylbrown.com.au)
NEXT_PUBLIC_STORY_SESSION_URL=https://darylbrown.com.au/the-story-session

# Podcast platform show URLs
NEXT_PUBLIC_SPOTIFY_SHOW_URL=https://open.spotify.com/show/[SHOW_ID]
NEXT_PUBLIC_APPLE_PODCASTS_URL=https://podcasts.apple.com/au/podcast/[SHOW_ID]
NEXT_PUBLIC_YOUTUBE_CHANNEL_URL=https://www.youtube.com/@[CHANNEL_HANDLE]
